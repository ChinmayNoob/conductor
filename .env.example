# Copy to .env and adjust. docker compose reads .env automatically.
# Every variable is optional for local development; the defaults in
# docker-compose.yml are insecure and only meant for your own machine.

# --- Postgres ---
POSTGRES_DB=taskscheduler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost       # set by docker-compose.yml
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=disable

# --- Security ---
# Shared secret that authenticates gRPC traffic between components. Required.
# Generate one with: openssl rand -hex 32
CONDUCTOR_CLUSTER_TOKEN=
# Admin API key created on startup. Clients send it as "Authorization: Bearer <key>".
# Use it to create scoped keys with `conductorctl apikey create`.
CONDUCTOR_API_KEY=
# Mutual TLS for gRPC (see docker-compose.tls.yml and scripts/gen-dev-certs.sh).
# CONDUCTOR_TLS_CERT=/certs/cluster.crt
# CONDUCTOR_TLS_KEY=/certs/cluster.key
# CONDUCTOR_TLS_CA=/certs/ca.crt
# CONDUCTOR_TLS_SERVER_NAME=conductor

# --- Networking (defaults shown) ---
# CONDUCTOR_COORDINATOR_ADDR=localhost:8080   # where api/workers reach the coordinator
# CONDUCTOR_COORDINATOR_LISTEN=:8080
# CONDUCTOR_API_LISTEN=:8081
# CONDUCTOR_WORKER_LISTEN=:9000
# CONDUCTOR_WORKER_ADVERTISE_ADDR=            # host:port; default is this machine's IP
# CONDUCTOR_WORKER_ID=                        # default is derived from the address

# --- Workers ---
# CONDUCTOR_WORKER_SLOTS=2                    # tasks a worker runs at once
# CONDUCTOR_WORKER_LABELS=gpu=true,region=eu  # tasks can require these labels
# CONDUCTOR_WORKER_PASS_ENV=AWS_REGION        # worker variables tasks may see (nothing else is passed)
# CONDUCTOR_DOCKER_SOCKET=/var/run/docker.sock  # enables container tasks if Docker answers

# --- Behaviour ---
# CONDUCTOR_PRIORITY_AGING=60s                # waiting tasks gain a priority level per interval; 0 disables
# CONDUCTOR_LOG_LEVEL=info                    # debug, info, warn, error
# CONDUCTOR_LOG_FORMAT=text                   # text or json
# CONDUCTOR_SHUTDOWN_TIMEOUT=25s              # how long workers let running tasks finish
# CONDUCTOR_MAX_OUTPUT_BYTES=1048576          # task output kept per task
# CONDUCTOR_MAX_REQUEST_BYTES=1048576         # largest accepted HTTP request body

# --- AI features (Phase 5) ---
OPENAI_API_KEY=
